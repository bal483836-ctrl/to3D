# 复制为 .env 并按需修改：cp .env.example .env

# ---- 适配器 / 推理 ----
# mock(无GPU) | http(自建混元桥接,需GPU) | tencent(腾讯云API,无需GPU,按次计费)
TO3D_ADAPTER=mock
# 当 TO3D_ADAPTER=http 时必填：混元 3D 推理服务地址，例 http://hunyuan3d:9000
TO3D_HUNYUAN_ENDPOINT=

# 当 TO3D_ADAPTER=tencent 时必填（腾讯云混元生3D，需 pip install -r backend/requirements-tencent.txt）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_RESULT_FORMAT=GLB          # GLB|OBJ|STL|USDZ|FBX
TENCENT_ENABLE_PBR=true
TENCENT_POLL_INTERVAL=5
TENCENT_POLL_TIMEOUT=600
# 一般无需改：
# TENCENT_AI3D_ENDPOINT=ai3d.tencentcloudapi.com
# TENCENT_AI3D_VERSION=2025-05-13
# 产物(glb/obj)输出目录
TO3D_OUTPUT_DIR=/tmp/to3d_outputs
# 推理请求超时(秒)与失败重试次数
TO3D_REQUEST_TIMEOUT=600
TO3D_ADAPTER_RETRIES=2

# ---- 持久化 ----
# 空=进程内存；单机持久化用 sqlite:///绝对路径.db；多副本用外部 DB(见 docs/生产部署.md)
TO3D_DB_URL=

# ---- 安全 ----
# 设置后启用鉴权：请求需带 Authorization: Bearer <key> 或 X-API-Key；WS 用 ?token=<key>
TO3D_API_KEY=
# CORS 允许来源；空=仅同源。逗号分隔域名或 * 开放跨域
TO3D_ALLOWED_ORIGINS=
# 单图(解码后)与请求体字节上限
TO3D_MAX_IMAGE_BYTES=10485760
TO3D_MAX_REQUEST_BYTES=67108864
# 是否禁止抓取私网地址(防 SSRF)、是否允许本地文件图片(防 LFI)
TO3D_BLOCK_PRIVATE_IPS=true
TO3D_ALLOW_LOCAL_FILE_IMAGES=false

# ---- 并发 / 生命周期 ----
# 同时进行的生成任务上限(GPU 通常 1~2)
TO3D_MAX_CONCURRENCY=2
# 任务与产物保留秒数、清理扫描间隔
TO3D_TASK_TTL_SECONDS=3600
TO3D_CLEANUP_INTERVAL=600
