# 复制为 .env：cp .env.example .env
# Blender 可执行文件路径（必填才能真实渲染）
# WSL/Linux 例： /usr/bin/blender    或直接 blender（在 PATH 中）
# Windows 例：   /mnt/c/Program Files/Blender Foundation/Blender 4.2/blender.exe
TO3D_BLENDER_BIN=blender

# 渲染引擎与采样
TO3D_DATASET_ENGINE=CYCLES        # CYCLES(更准) | BLENDER_EEVEE(更快)
TO3D_DATASET_SAMPLES=64
TO3D_DATASET_TIMEOUT=3600

# 工作目录与端口
TO3D_DS_WORKDIR=./_work
PORT=8100
