# 混元桥接服务配置模板。用法二选一：
#   1) 导出到环境：  set -a; . ./.env; set +a; python hunyuan_server.py
#   2) docker：      docker run --gpus all --env-file serving/.env -p 9000:9000 to3d-hunyuan

# ---- 选择混元模型变体（决定显存与质量）----
# 多视图形状（主几何来源，>=2 张图时用）
HY3D_SHAPE_MODEL=tencent/Hunyuan3D-2mv
# 单图形状（<2 张图、以及 /reference 文生→图→形状 时用）
HY3D_SHAPE_MODEL_SINGLE=tencent/Hunyuan3D-2
# 纹理（Hunyuan3D-Paint）
HY3D_TEX_MODEL=tencent/Hunyuan3D-2
# 文生图（/reference 与文字增强纹理用；显存紧张可留空以关闭，见下）
HY3D_T2I_MODEL=Tencent-Hunyuan/HunyuanDiT-v1.1-Diffusers-Distilled

# ---- 推理参数 ----
HY3D_DEVICE=cuda
HY3D_STEPS=50            # 去噪步数：调小(20~30)更快、显存/时延更低
PORT=9000

# ---- 纹理/材质分析（让 花纹 & 材质 两维真正生效）----
HY3D_TEX_ANALYZER=clip  # clip=渲染图CLIP/VQA+PBR；prompt=关键词回退(免装 pyrender/cn_clip)
HY3D_CLIP_MODEL=ViT-B-16
HY3D_PATTERN_THRESHOLD=0.55
HY3D_RENDER_VIEWS=4
HY3D_RENDER_RES=384

# ---- 安全（与主服务一致，默认防 SSRF/LFI）----
HY3D_BLOCK_PRIVATE_IPS=1
HY3D_ALLOW_LOCAL_FILE=0

# ---- HuggingFace（首次自动下载权重）----
# 国内加速： HF_ENDPOINT=https://hf-mirror.com
# 缓存目录： HF_HOME=/data/hf
